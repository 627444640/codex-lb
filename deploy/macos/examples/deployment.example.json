{
  "data_dir": "/absolute/path/to/codex-lb-runtime/data",
  "manager_python": "/absolute/path/to/python3.12",
  "public_url": "https://localhost:8443",
  "backend": {
    "command": [
      "/absolute/path/to/codex-lb",
      "--host",
      "127.0.0.1",
      "--port",
      "2455"
    ],
    "environment": {
      "CODEX_LB_DATA_DIR": "/absolute/path/to/codex-lb-runtime/data"
    }
  },
  "https": {
    "command": [
      "/absolute/path/to/codex-lb-runtime/state/runtime/caddy",
      "run",
      "--config",
      "/absolute/path/to/codex-lb-runtime/config/Caddyfile",
      "--adapter",
      "caddyfile"
    ],
    "environment": {
      "XDG_DATA_HOME": "/absolute/path/to/codex-lb-runtime/state",
      "XDG_CONFIG_HOME": "/absolute/path/to/codex-lb-runtime/state/caddy-config"
    }
  }
}
